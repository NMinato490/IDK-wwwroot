# Turbo monorepo root (wwwroot)
# Copy to .env and fill per environment. Per-app overrides live in apps/*/.env.local

# Shared
NODE_ENV=development
TURBO_TOKEN=
TURBO_TEAM=

# Apps (URLs must match ports in each app's .env.local)
NEXT_PUBLIC_LABWEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE1_URL=http://localhost:3001
NEXT_PUBLIC_SITE2_URL=http://localhost:3002
NEXT_PUBLIC_PORTAL_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:8080
